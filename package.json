{
  "name": "hushjot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An extremely fast, encrypted, local-first cloud text and Markdown notepad.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/hushjot/hushjot-app.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build:core": "node tools/build-core.mjs",
    "vectors": "npm run build:core && node tools/make-format-vectors.mjs",
    "test": "vitest run --exclude 'tests/rules/**'",
    "verify": "npm run check && npm run build:core && npm test && npm run test:rules && npm run bench",
    "bench": "npm run bench:size && npm run bench:app && npm run bench:phase2 && npm run bench:phase3 && npm run bench:phase4 && npm run bench:allowlist && npm run bench:vault && npm run bench:phase5 && npm run bench:phase6 && npm run bench:mobile && npm run bench:scale && npm run bench:preview && npm run bench:history && npm run bench:historySync && npm run bench:share && npm run bench:lockdown && npm run bench:rowMenu && npm run bench:capture && npm run bench:dragDrop",
    "bench:size": "node bench/size.mjs",
    "bench:app": "node bench/app.mjs",
    "bench:phase2": "node bench/phase2.mjs",
    "bench:scale": "node bench/scale.mjs",
    "bench:spikes": "node bench/run.mjs",
    "bench:phase3": "node bench/phase3.mjs",
    "test:rules": "firebase emulators:exec --only firestore,auth --project teksto-rules-test 'vitest run --config vitest.rules.config.ts'",
    "emulators": "firebase emulators:start --only firestore,auth --project teksto-dev",
    "bench:phase4": "firebase emulators:exec --only firestore,auth --project teksto-dev 'node bench/phase4.mjs'",
    "bench:allowlist": "firebase emulators:exec --only firestore,auth --project teksto-dev 'node bench/allowlist.mjs'",
    "bench:vault": "firebase emulators:exec --only firestore,auth --project teksto-dev 'node bench/vaultBinding.mjs'",
    "bench:phase5": "firebase emulators:exec --only firestore,auth --project teksto-dev 'node bench/phase5.mjs'",
    "icons": "node tools/make-icons.mjs",
    "export:public": "node tools/export-public.mjs",
    "bench:phase6": "node bench/phase6.mjs",
    "bench:mobile": "node bench/mobile.mjs",
    "bench:preview": "node bench/preview.mjs",
    "bench:history": "node bench/history.mjs",
    "bench:rowMenu": "node bench/rowMenu.mjs",
    "bench:capture": "node bench/capture.mjs",
    "bench:dragDrop": "node bench/dragDrop.mjs",
    "bench:kdfDevice": "node bench/device.mjs",
    "bench:historySync": "firebase emulators:exec --only firestore,auth --project teksto-dev 'node bench/historySync.mjs'",
    "bench:share": "firebase emulators:exec --only firestore,auth --project teksto-dev 'node bench/share.mjs'",
    "bench:lockdown": "firebase emulators:exec --only firestore,auth --project teksto-dev 'node bench/lockdown.mjs'",
    "prepublishOnly": "node tools/guard-publish.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "firebase": "^13.1.0",
    "hash-wasm": "^4.12.0",
    "mermaid": "^12.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
