# HushJot — environment configuration
#
# Copy to `.env.production` (or `.env.local`) and fill in from
# `firebase apps:sdkconfig WEB`. See docs/firebase-setup.md.
#
# These values are PUBLIC. Firebase config identifies a project, it does not
# authorise anything — access control lives entirely in firestore.rules, which
# is why those are tested. Committing them would be harmless; they are kept out
# of git only so different environments do not fight over one file.
#
# The VITE_ prefix is what makes that true: Vite copies only VITE_ variables
# into the browser bundle, where every visitor can read them, and leaves every
# other name behind. Never give a secret a VITE_ name.
#
# If VITE_FIREBASE_API_KEY is unset and emulators are off, the app runs
# entirely local-only: everything works, nothing leaves the browser, and the
# account panel says so.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# The billing API. The app calls it for one thing only: a vault reset, for a
# signed-in user who has lost both the passphrase and the recovery code. Its
# origin is added to connect-src by the CSP plugin; firebase.json names the
# default, so change that header too if this is ever not the default.
# VITE_HUSHJOT_API_URL=https://api.hushjot.com

# --- local emulators -------------------------------------------------------
# Set to "true" in `.env.local` to point a dev build at the emulator suite.
# Never set this in `.env.production`.
VITE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_PORT=9098
VITE_FIREBASE_FIRESTORE_PORT=8085
